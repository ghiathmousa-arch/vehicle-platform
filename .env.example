# رابط قاعدة البيانات PostgreSQL
# للنشر على Vercel: استخدم رابط الـ POOLED من Neon (فيه -pooler) وليس المباشر
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# مفتاح توقيع الجلسات — ولّده بالأمر: openssl rand -base64 32
# لا تستخدم نفس المفتاح بين التطوير والإنتاج
SESSION_SECRET="ضع_هنا_مفتاح_عشوائي_طويل"

# كلمة مرور المشرف الأولية (يستخدمها prisma db seed فقط)
SEED_ADMIN_EMAIL="admin@vehicles.gov.sa"
SEED_ADMIN_PASSWORD="غيّرها_قبل_النشر"

# إعدادات اختيارية للموقع
# SITE_NAME="نظام إدارة المركبات"
# CURRENCY="ل.س"
